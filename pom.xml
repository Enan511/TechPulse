<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ca.uwindsor</groupId>
    <artifactId>techpulse</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>TechPulse</name>
    <description>COMP 8547 Group 7 - Multi-Platform Electronics Price Aggregator and Search Analytics Engine</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Code must compile for Java 17. Any JDK 17 or newer can build it (we recommend JDK 21). -->
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>ca.uwindsor.techpulse.TechPulseApp</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Jsoup: download pages and walk the HTML DOM -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>

        <!-- Selenium: only for stores that block Jsoup (Cloudflare "verify you are human"), as in Assignment 1 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.52.0</version>
        </dependency>

        <!-- JUnit 5/6 for our tests in src/test/java -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
            <!-- lets you run the app from a terminal with: mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
            </plugin>
        </plugins>
    </build>
</project>
